<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_custom" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[@name='div_sched_date']" position="after">
            <div t-if="o.picking_type_id.code == 'outgoing' and o.carrier_id" class="col col-3 mw-100 mb-2">
                <strong>Carrier</strong>
                <div t-field="o.carrier_id" class="m-0"/>
            </div>
            <div t-if="o.shipping_weight" class="col col-3 mw-100 mb-2">
                <strong>Total Weight</strong>
                <div>
                    <span t-field="o.shipping_weight"/>
                    <span t-field="o.weight_uom_name"/>
                </div>
            </div>
            <div t-if="o.carrier_tracking_ref" class="col col-3 mw-100 mb-2" style="max-width:30%;">
                <strong>Tracking Number</strong>
                <div t-field="o.carrier_tracking_ref" class="m-0"/>
            </div>
            
            <div class="col col-3 mw-100 mb-2" name="div_package_count">
                <strong>Total Packages</strong>
                <div t-esc="len(o.move_line_ids.mapped('result_package_id'))" class="m-0"/>
            </div>

            <t t-set="has_hs_code" t-value="o.move_ids.filtered(lambda l: l.product_id.hs_code)"/>
        </xpath>

        <xpath expr="//table[@name='stock_move_line_table']/thead/tr" position="inside">
            <th t-if="has_hs_code">HS Code</th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/thead/tr" position="inside">
            <th t-if="has_hs_code">HS Code</th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr" position="inside">
            <td t-if="has_hs_code">
                <span t-field="move.product_id.hs_code"/>
            </td>
        </xpath>

        <xpath expr="//table[@name='stock_backorder_table']/preceding-sibling::p[1]" position="replace"/>
        <xpath expr="//table[@name='stock_backorder_table']" position="replace"/>

        <!-- Replace the "Delivered" column with "Net Weight" (picking not yet validated) -->
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_quantity']" position="replace">
            <th name="th_sm_quantity" class="text-end"><strong>Net Weight</strong></th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[@class='o_td_quantity text-end'][2]" position="replace">
            <td class="text-end">
                <span t-esc="'%.2f' % (move.product_id.weight * move.product_uom_qty)"/>
                <span t-esc="move.product_id.weight_uom_name"/>
            </td>
        </xpath>

        <!-- Replace the "Delivered" column with "Net Weight" (picking validated) -->
        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_quantity']" position="replace">
            <th name="th_sml_quantity" class="text-center">Net Weight</th>
        </xpath>
    </template>

    <template id="stock_report_delivery_has_serial_move_line_net_weight" inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td[@name='move_line_lot_quantity']" position="replace">
            <td class="text-center" name="move_line_lot_quantity">
                <span t-esc="'%.2f' % (move_line.product_id.weight * move_line.quantity)"/>
                <span t-esc="move_line.product_id.weight_uom_name"/>
            </td>
        </xpath>
    </template>

    <template id="stock_report_delivery_aggregated_move_lines_net_weight" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="replace">
            <td class="text-center" name="move_line_aggregated_quantity">
                <t t-if="aggregated_lines[line]['quantity']">
                    <span t-esc="'%.2f' % (aggregated_lines[line]['product'].weight * aggregated_lines[line]['quantity'])"/>
                    <span t-esc="aggregated_lines[line]['product'].weight_uom_name"/>
                </t>
            </td>
        </xpath>
    </template>
</odoo>